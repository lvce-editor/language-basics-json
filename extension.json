{
  "id": "builtin.language-basics-json",
  "name": "Language Basics JSON",
  "description": "Provides syntax highlighting and bracket matching in JSON files.",
  "languages": [
    {
      "id": "json",
      "extensions": [
        ".babelrc",
        ".bowerrc",
        ".code-profile",
        ".code-snippets",
        ".code-workspace",
        ".cpuprofile",
        ".css.map",
        ".eslintrc.json",
        ".eslintrc",
        ".geojson",
        ".github-issues",
        ".har",
        ".heapsnapshot",
        ".hintrc",
        ".ipynb",
        ".js.map",
        ".jscsrc",
        ".jsfmtrc",
        ".jshintrc",
        ".jslintrc",
        ".json",
        ".jsonld",
        ".mention-bot",
        ".mjs.map",
        ".prettierrc",
        ".sublime-project",
        ".swcrc",
        ".tour",
        ".ts.map",
        ".webmanifest"
      ],
      "fileNames": [
        "composer.lock",
        ".watchmanconfig",
        ".all-contributorsrc",
        ".imgbotconfig",
        ".stylelintrc",
        ".parcelrc",
        ".publishrc",
        ".whitesource",
        ".mention-bot",
        "pdfjs.config",
        "tsconfig.tsbuildinfo",
        ".gdntsa",
        ".nycrc",
        "manifest.webapp",
        ".alexrc",
        ".yarn-integrity",
        "tsconfig.tsbuildinfo"
      ],
      "tokenize": "src/tokenizeJson.js",
      "configuration": "./languageConfiguration.json"
    },
    {
      "id": "jsonc",
      "extensions": [".jsonc"],
      "fileNames": ["settings.json"],
      "tokenize": "src/tokenizeJson.js",
      "configuration": "./languageConfiguration.json"
    },
    {
      "id": "jsonc",
      "extensions": [".jsonc"],
      "tokenize": "src/tokenizeJson.js"
    },
    {
      "id": "jsonl",
      "extensions": [".jsonl"],
      "tokenize": "src/tokenizeJson.js"
    }
  ],
  "repository": "https://github.com/lvce-editor/language-basics-json"
}
